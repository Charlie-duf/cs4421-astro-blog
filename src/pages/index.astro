---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section aria-labelledby="welcome-heading">
				<h1 id="welcome-heading">Welcome to our food blog!</h1>
				<p>
					We’re Leo Martins and Maya Chen, two expert chefs. We focus on creating approachable recipes that are easy to follow and delicious to eat. Our goal is to inspire you to cook more at home and enjoy the process of making food.
				</p>
			</section>

			<section aria-labelledby="about-heading">
				<h2 id="about-heading">New recipes every day!</h2>
				<p>
					This site contains a collection of approachable recipes inspired by the flavors and food stories
					we love. We pride ourselves on being able to create diverse recipes so there should be a recipe for everyone!
					Furthermore, we add a new recipe every day, so be sure to check back often for new content (or sign up to our newsletter to never miss out)!

				</p>
				<p>Want to request a specific recipe? <a href="/about"> Contact us!</a></p>
			
				<ol>
					<li><a href="/blog">Browse the recipes</a></li>
					<li><a href="/about"> About us!</a></li>
				</ol>
			</section>
		</main>
		<Footer />
	</body>
</html>
