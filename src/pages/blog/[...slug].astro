---
import { getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

const slug = Astro.params.slug;
const post = slug ? await getEntry('blog', slug) : undefined;
const author = post ? await getEntry('authors', post.data.author) : undefined;

if (post && !author) {
	throw new Error(`Author "${post.data.author}" not found for post "${post.id}"`);
}

if (!post) {
	Astro.response.status = 404;
}

const Content = post ? (await render(post)).Content : undefined;
---

{
	post && author && Content ? (
		<BlogPost {...post.data} author={author.data}>
			<Content />
		</BlogPost>
	) : (
		<main>
			<h1>Recipe not found</h1>
			<p>The recipe you're looking for doesn't exist.</p>
		</main>
	)
}
