---
import { Image } from 'astro:assets';
//import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import ChefLeoImage from '../assets/profile.jpg';
import Layout from '../layouts/BlogPost.astro';
---

<style>
	.chef-profile {
		display: flex;
		align-items: flex-start;
		gap: 1.5rem;
		margin: 2rem 0;
	}

	.chef-photo {
		width: 180px;
		height: 180px;
		flex: 0 0 180px;
		object-fit: cover;
		border-radius: 50%;
	}

	.chef-profile h2 {
		margin-bottom: 0.75rem;
	}

	.chef-profile p {
		margin-bottom: 0.75rem;
	}

	.chef-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (max-width: 520px) {
		.chef-profile {
			flex-direction: column;
			gap: 1rem;
		}
	}
</style>

<Layout
	title="About Me"
	description="About the blog's creator."
	pubDate={new Date('Oct 11, 2026')}
	
>
	<p>
		Welcome to my food blog, on this site you will find a new tasty recipe posted every day. If you would like to contact me (to request a feature or a specific recipe, my socials are liked below). 
	</p>

	<section class="chef-profile" aria-labelledby="leo-heading">
		<Image class="chef-photo" src={ChefLeoImage} alt="Chef Leo Martins" />
		<div>
			<h2 id="leo-heading">Charlie Duffy</h2>
			<p>
				
			</p>
			<ul class="chef-links" aria-label="Leo Martins around the web">
				<li><a href="https://github.com/Charlie-duf" target="_blank" rel="noopener noreferrer">GitHub</a></li>
				<li>
					<a
						href="https://www.linkedin.com/in/charles-duffy-3a03a8355/"
						target="_blank"
						rel="noopener noreferrer">LinkedIn</a
					>
				</li>
			</ul>
		</div>
	</section>
</Layout>
